   3          /*
   4            //Port-->0,1,2,3
   5            // Only PORT-0 is PulledUp for Activate.
   6            //PORT=[8,4,2,1;8,4,2,1]
   7           //Index=[7,6,5,4,3,2,1,0]
   8          
   9           sbit led0 = P0^7; // Red
  10           sbit led1 = P1^7; //Yellow;sck
  11           sbit led2 = P2^7; //Green
  12           sbit led3 = P3^7; //Blue
  13           */
  14           
  15           
  16           // Delay Function
  17           void delay(unsigned int ms)
  18          {
  19   1          unsigned int i;
  20   1          for(i=0; i<ms; i++)
  21   1          {
  22   2              TMOD &= 0xF0;  // Clear Timer0 control bits
  23   2              TMOD |= 0x01;  // Set Timer0 in Mode1 (16-bit)
  24   2      
  25   2              TH0 = 0xFC;    // Load high byte for 1ms delay
  26   2              TL0 = 0x66;    // Load low byte  for 1ms delay
  27   2      
  28   2              TF0 = 0;       // Clear Timer0 overflow flag
  29   2              TR0 = 1;       // Start Timer0
  30   2      
  31   2              while(TF0 == 0); // Wait until Timer0 overflows
  32   2      
  33   2              TR0 = 0;       // Stop Timer0
  34   2              TF0 = 0;       // Clear overflow flag again
  35   2          }
  36   1       }
  37          
  38           
  39           void red(unsigned int ms)
  40           {
  41   1              P0 = 0x80;  //Port0; Pin7 = High; Others = Low;
  42   1              delay(ms);
  43   1              P0 = 0x00;  //Port0; All-Pin = Low;
  44   1              delay(ms);
  45   1       }
  46           
  47            void yellow(unsigned int ms)
  48           {
  49   1              P1 = 0x80;  //Port1; Pin7 = High; Others = Low;
  50   1              delay(ms);
  51   1              P1 = 0x00;  //Port1; All-Pin = Low;
  52   1              delay(ms);
  53   1       }
  54           
